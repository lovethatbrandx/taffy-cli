{
  "name": "taffy-cli",
  "version": "1.0.0",
  "description": "Natural language to action — Taffy knows your apps, your vibe, and your shell.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "taffy": "./dist/taffy-cli"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
